{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "webui/server/**/*"],
  "exclude": ["node_modules", "dist", "webui/client"]
}
