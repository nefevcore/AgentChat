{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@core/*":     ["src/core/*"],
      "@agents/*":   ["src/agents/*"],
      "@app/*":      ["src/app/*"],
      "@plugins/*":  ["src/plugins/*"],
      "@services/*": ["src/services/*"],
      "@llm/*":      ["src/core/llm/*"],
      "@utils/*":    ["src/utils/*"],
      "@shared/*":   ["src/shared/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/ui/webui",
    "src/ui/webui-v2"
  ]
}
