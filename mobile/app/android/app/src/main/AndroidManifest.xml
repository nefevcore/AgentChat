<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- windowSoftInputMode=adjustResize（cr-31 Phase③）：键盘弹出时压缩 WebView
             视口（而非整页上移）——100vh 高度链随之收缩，聊天输入框与消息区
             自然让位；不声明则交给系统 heuristics（pan/resize 因厂商而异，输入框
             会被键盘盖住）。真机验证见 m3-realdevice-checklist.md。 -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 扫码后经 agentchat://pair?... 深链唤起（核心端二维码） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="agentchat" android:host="pair" />
            </intent-filter>

        </activity>

        <!-- 远程链路前台服务：持 relay 连接与回环桥的生命周期（方案 §4.4「锁」行） -->
        <service
            android:name="agentchat.noise.android.RemoteLinkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 前台服务（持链路）；Android 14 起 dataSync 型需显式声明 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 通知（前台服务常驻通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 配对：扫码需相机；agentchat:// 深链唤起本 App -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

</manifest>
