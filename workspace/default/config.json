{
  "$comment": "AgentChat 全局配置。扩展/工具使用命名空间前缀（如 tool.bash）。核心字段直接写在顶层。",
  "timezone": "Asia/Shanghai",
  "maxHops": 5,
  "messageQueryDefaultLimit": 50,
  "chime": {
    "$comment": "全局报时配置。enabled=true 时，每到 times 中的时间点，向所有 Agent 发送报时通知。",
    "enabled": true,
    "times": [
      "08:00",
      "11:00",
      "14:00",
      "17:00",
      "20:00",
      "23:00"
    ]
  },
  "llmProviders": {
    "$comment": "LLM Provider 池。Agent 可通过 \"llm\": \"deepseek-pro\" 引用，也可覆盖个别字段：\"llm\": { \"$ref\": \"deepseek-pro\", \"temperature\": 0.5 }",
    "deepseek-v4-flash": {
      "provider": "deepseek",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-v4-flash",
      "reasoning_effort": "high",
      "thinking": true,
      "logprobs": false,
      "tool_choice": "auto",
      "default": true
    },
    "deepseek-v4-pro": {
      "provider": "deepseek",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-v4-pro",
      "reasoning_effort": "high",
      "thinking": true,
      "logprobs": false,
      "default": false
    },
    "internal-vllm": {
      "provider": "openai",
      "base_url": "http://10.168.25.156:8001/v1",
      "model": "Qwen3-235B-A22B",
      "default": false
    },
    "impc-deepseek-v4": {
      "provider": "deepseek",
      "base_url": "http://10.168.20.208:8000/v1",
      "model": "deepseek-v4",
      "reasoning_effort": "high",
      "thinking": true,
      "logprobs": false,
      "tool_choice": "auto",
      "default": false
    },
    "impc-deepseek-r1": {
      "provider": "deepseek",
      "base_url": "http://10.168.20.14:6061/v1",
      "model": "bailian-deepseek-r1",
      "reasoning_effort": "high",
      "thinking": true,
      "logprobs": false,
      "tool_choice": "auto",
      "default": false
    }
  },
  "searchProviders": {
    "$comment": "Search Provider 池。Agent 可通过 \"tool.web_search\": { \"$ref\": \"tavily-free\" } 引用",
    "tavily-free": {
      "provider": "tavily",
      "defaultResults": 5,
      "defaultDepth": "advanced",
      "defaultTopic": "general",
      "rawContentMaxLen": 2000,
      "default": true
    }
  },
  "extension.agent_session": {
    "maxContextTokens": 1000000,
    "keepRecentRatio": 0.03,
    "summaryPreviewLen": 1000,
    "idleArchiveSec": 14400,
    "messageQueryDefaultLimit": 50,
    "archiveMinMessages": 200,
    "archiveTokenRatio": 0.5
  },
  "extension.agent_memory": {
    "memoryBudgetTokens": 600
  },
  "tool.bash": {
    "defaultTimeout": 30000,
    "maxTimeout": 120000,
    "outputMaxLen": 50000,
    "maxBuffer": 10485760
  },
  "tool.read": {
    "maxLines": 2000,
    "maxBytes": 51200
  },
  "extension.agent_prompt": {
    "tools": true
  },
  "tool.web_search": {
    "provider": "tavily",
    "quota": 30,
    "creditsFile": "workspace/default/.web_search_credits.json"
  }
}
