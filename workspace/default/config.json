{
  "$comment": "AgentChat 全局配置。扩展/工具使用命名空间前缀（如 tool.bash）。核心字段直接写在顶层。",
  "timezone": "Asia/Shanghai",
  "maxHops": 5,
  "messageQueryDefaultLimit": 20,
  "llmProviders": {
    "deepseek-v4-flash": {
      "provider": "deepseek",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-v4-flash",
      "reasoning_effort": "high",
      "thinking": true,
      "logprobs": false,
      "tool_choice": "auto",
      "default": false
    },
    "deepseek-v4-pro": {
      "provider": "deepseek",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-v4-pro",
      "reasoning_effort": "high",
      "thinking": true,
      "logprobs": false,
      "default": false
    },
    "glm-5.3": {
      "provider": "glm",
      "base_url": "https://open.bigmodel.cn/api/coding/paas/v4",
      "model": "glm-5.3",
      "reasoning_effort": "max",
      "thinking": true,
      "default": true
    }
  },
  "searchProviders": {
    "$comment": "Search Provider 池。Agent 可通过 \"tool.web_search\": { \"$ref\": \"tavily-free\" } 引用",
    "tavily-free": {
      "provider": "tavily",
      "defaultResults": 5,
      "defaultDepth": "advanced",
      "defaultTopic": "general",
      "rawContentMaxLen": 2000,
      "default": true
    }
  },
  "agent.session": {
    "maxContextTokens": 1000000,
    "keepRecentRatio": 0.03,
    "summaryPreviewLen": 4000,
    "idleArchiveSec": 14400,
    "messageQueryDefaultLimit": 20,
    "archiveTokenRatio": 0.5
  },
  "agent.memory": {
    "memoryBudgetTokens": 10000
  },
  "tool.bash": {
    "defaultTimeout": 30000,
    "maxTimeout": 120000,
    "outputMaxLen": 50000,
    "maxBuffer": 10485760
  },
  "tool.web_search": {
    "provider": "tavily",
    "quota": 30,
    "creditsFile": "workspace/default/.web_search_credits.json"
  },
  "timer": {
    "$comment": "全局定时任务配置（原 chime 泛化）：tasks 每个 = 时间点 + 提示 + 目标 Agent",
    "enabled": true,
    "tasks": [
      {
        "time": "08:00",
        "hint": "现在是 {{time}}，早安报时。请简要汇报今日计划与待办。"
      },
      {
        "time": "12:00",
        "hint": "现在是 {{time}}，午间报时。请简要汇报上午进展与剩余待办。"
      },
      {
        "time": "17:00",
        "hint": "现在是 {{time}}，傍晚报时。请简要总结今日成果并规划明日事项。"
      },
      {
        "hint": "__archive_all__",
        "targets": [
          "*"
        ],
        "time": "23:30",
        "builtin": true
      },
      {
        "time": "04:00",
        "hint": "__backup_all__",
        "targets": [
          "*"
        ],
        "builtin": true
      }
    ]
  },
  "agent.mcp": {
    "mcpFile": "C:\\Users\\xiaofeng\\Documents\\Dev\\WorkDev\\mcp\\impc-shyy-mcp.json"
  }
}
