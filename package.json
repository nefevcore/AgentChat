    "ac-mcp-core": "workspace:*",
    "ac-memory": "workspace:*",
    "ac-memory-core": "workspace:*",
    "ac-persona": "workspace:*",
    "ac-plugin-core": "workspace:*",
    "ac-plugin-gates": "workspace:*",
    "ac-plugin-registry": "workspace:*",
    "ac-restart": "workspace:*",
