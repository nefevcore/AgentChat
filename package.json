{
  "name": "@nefevcore/agentchat",
  "version": "0.8.2",
  "packageManager": "pnpm@11.21.0",
  "private": false,
  "type": "module",
  "description": "AgentChat —— cordis 4 插件化 Agent 平台",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nefevcore/AgentChat.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agentchat": "bin/agentchat.js"
  },
  "main": "./dist/agentchat.mjs",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/agentchat.js",
    "dev": "node --expose-internals --import tsx src/ac-app/src/boot.ts",
    "dev:supervised": "node --import tsx src/supervisor.mjs",
    "dev:demo": "node --expose-internals --import tsx src/ac-app/src/boot-yml-main.ts",
    "smoke": "tsx src/ac-app/src/smoke.ts",
    "chat": "tsx src/ac-app/src/chat.ts",
    "webui": "pnpm --filter ac-webui-app dev",
    "webui:build": "pnpm --filter ac-webui-app build",
    "webui:typecheck": "pnpm --filter ac-webui-app typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:deps": "node scripts/check-deps.mjs",
    "build": "pnpm -r build",
    "preview:boot": "pnpm dev",
    "preview:supervised": "pnpm dev:supervised",
    "preview:boot:demo": "pnpm dev:demo",
    "preview:smoke": "pnpm smoke",
    "preview:chat": "pnpm chat",
    "preview:webui": "pnpm webui",
    "preview:webui:build": "pnpm webui:build",
    "preview:typecheck": "pnpm typecheck",
    "preview:test": "pnpm test",
    "preview:usage-baseline": "tsx src/scripts/usage-baseline.ts workspace/preview",
    "build:frontend": "pnpm --filter ac-webui-app build",
    "build:bundle": "node scripts/build-bundle.mjs"
  },
  "devDependencies": {
    "ac-extension-core": "workspace:*",
    "esbuild": "^0.28.2",
    "ws": "^8.21.0",
    "@agentchat/cordis": "workspace:*",
    "@agentchat/cordis-hmr": "workspace:*",
    "@agentchat/cordis-include": "workspace:*",
    "@agentchat/cordis-loader": "workspace:*",
    "@agentchat/cordis-logger": "workspace:*",
    "@agentchat/cordis-timer": "workspace:*",
    "ac-agent-admin": "workspace:*",
