{
  "name": "agentchat",
  "version": "0.7.1",
  "private": false,
  "type": "module",
  "description": "AgentChat —— cordis 4 插件化 Agent 平台",
  "bin": {
    "agentchat": "bin/agentchat.js"
  },
  "main": "./dist/agentchat.mjs",
  "files": [
    "bin",
    "dist",
    "docs/tool-dev-guide.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/agentchat.js",
    "dev": "node --expose-internals --import tsx node_modules/@agentchat/cordis/bin.js",
    "dev:supervised": "tsx src/boot/boot/src/supervisor.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @agentchat/webui build",
    "webui:typecheck": "pnpm --filter @agentchat/webui typecheck"
  },
  "dependencies": {},
  "devDependencies": {
    "@agentchat/cordis": "workspace:*",
    "@agentchat/cordis-hmr": "workspace:*",
    "@agentchat/cordis-include": "workspace:*",
    "@agentchat/cordis-loader": "workspace:*",
    "@agentchat/cordis-logger": "workspace:*",
    "@agentchat/cordis-timer": "workspace:*",
    "@agentchat/agent-loop": "workspace:*",
    "@agentchat/agent-config": "workspace:*",
    "@agentchat/agent-mcp": "workspace:*",
    "@agentchat/agent-memory": "workspace:*",
    "@agentchat/agent-prompt": "workspace:*",
    "@agentchat/agent-session": "workspace:*",
    "@agentchat/agent-skill": "workspace:*",
    "@agentchat/agent-tools": "workspace:*",
    "@agentchat/agents": "workspace:*",
    "@agentchat/archive": "workspace:*",
    "@agentchat/boot": "workspace:*",
    "@agentchat/contracts": "workspace:*",
    "@agentchat/dev": "workspace:*",
    "@agentchat/durable-interaction": "workspace:*",
    "@agentchat/fs": "workspace:*",
    "@agentchat/hello": "workspace:*",
    "@agentchat/hooks": "workspace:*",
    "@agentchat/interaction": "workspace:*",
    "@agentchat/llm": "workspace:*",
    "@agentchat/llm-deepseek": "workspace:*",
    "@agentchat/llm-factory": "workspace:*",
    "@agentchat/llm-glm": "workspace:*",
    "@agentchat/llm-openai": "workspace:*",
    "@agentchat/math": "workspace:*",
    "@agentchat/plugins": "workspace:*",
    "@agentchat/restart": "workspace:*",
    "@agentchat/router": "workspace:*",
    "@agentchat/security": "workspace:*",
    "@agentchat/server": "workspace:*",
    "@agentchat/session-tools": "workspace:*",
    "@agentchat/shell": "workspace:*",
    "@agentchat/subagent": "workspace:*",
    "@agentchat/timer": "workspace:*",
    "@agentchat/toolkit": "workspace:*",
    "@agentchat/tools": "workspace:*",
    "@agentchat/types": "workspace:*",
    "@agentchat/web": "workspace:*",
    "@agentchat/webui": "workspace:*",
    "@agentchat/workspace": "workspace:*",
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
