{
  "name": "@nefevcore/agentchat",
  "version": "0.7.1",
  "packageManager": "pnpm@11.21.0",
  "private": false,
  "type": "module",
  "description": "AgentChat —— cordis 4 插件化 Agent 平台",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agentchat": "bin/agentchat.js"
  },
  "main": "./dist/agentchat.mjs",
  "files": [
    "bin",
    "dist",
    "docs/tool-dev-guide.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/agentchat.js",
    "dev": "node --expose-internals --import tsx src/boot/boot/src/loader-boot.ts",
    "dev:supervised": "tsx src/boot/boot/src/supervisor.ts",
    "preview:typecheck": "tsc --noEmit -p preview/tsconfig.json",
    "preview:test": "vitest run preview",
    "preview:smoke": "tsx preview/ac-app/src/smoke.ts",
    "preview:boot": "node --expose-internals --import tsx preview/ac-app/src/boot.ts",
    "preview:chat": "tsx preview/ac-app/src/chat.ts",
    "preview:boot:demo": "node --expose-internals --import tsx preview/ac-app/src/boot-yml-main.ts",
    "preview:supervised": "node --import tsx preview/supervisor.mjs",
    "preview:webui": "pnpm --filter ac-webui-app dev",
    "preview:webui:build": "pnpm --filter ac-webui-app build",
    "typecheck": "tsc --noEmit && pnpm preview:typecheck",
    "check:deps": "node scripts/check-deps.mjs",
    "test": "vitest run",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @agentchat/webui build",
    "build:bundle": "node scripts/build-bundle.mjs",
    "gen:bundle-rows": "node scripts/gen-bundle-rows.mjs",
    "webui:typecheck": "pnpm --filter @agentchat/webui typecheck",
    "preview:usage-baseline": "tsx preview/scripts/usage-baseline.ts workspace/preview"
  },
  "devDependencies": {
    "ac-extension-core": "workspace:*",
    "@agentchat/agent-config": "workspace:*",
