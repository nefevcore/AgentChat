    "ac-durable-interaction": "workspace:*",
    "ac-edit-core": "workspace:*",
    "ac-fs-search": "workspace:*",
    "ac-fs-tools": "workspace:*",
    "ac-glob-core": "workspace:*",
    "ac-goal": "workspace:*",
    "ac-group": "workspace:*",
    "ac-hello": "workspace:*",
