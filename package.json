{
  "name": "agentchat",
  "version": "0.5.0",
  "description": "AgentChat core - Node.js + TypeScript",
  "main": "dist/src/app/index.js",
  "types": "dist/src/app/index.d.ts",
  "scripts": {
    "build": "tsc -p .",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend:watch\" \"npm run dev:frontend\"",
    "dev:backend": "tsx -r tsconfig-paths/register src/app/index.ts",
    "dev:backend:watch": "nodemon --watch src --watch webui/server --ext ts --exec tsx -r tsconfig-paths/register src/app/index.ts",
    "dev:frontend": "cd webui/client && npm run dev",
    "prestart": "npm run build",
    "start": "node -r tsconfig-paths/register dist/src/app/index.js",
    "typecheck": "tsc --noEmit",
    "build:frontend": "cd webui/client && npm run build",
    "build:release": "npx tsx scripts/build-release.ts",
    "build:supervisor": "npx tsx scripts/build-supervisor.ts",
    "release": "npx tsx scripts/release.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:supervised": "tsx -r tsconfig-paths/register src/app/supervisor.ts",
    "start:supervised": "node -r tsconfig-paths/register dist/src/app/supervisor.js",
    "update:config": "node scripts/update-config.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "adm-zip": "^0.6.0",
    "chinese-lunar": "^0.1.4",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "mathjs": "^15.2.0",
    "multer": "^2.2.0",
    "openai": "^4.47.0",
    "punycode": "^2.3.1",
    "tiktoken": "^1.0.15",
    "tsconfig-paths": "^4.2.0",
    "ws": "^8.21.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.5.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.3",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.1",
    "tsx": "^4.22.4",
    "typescript": "^5.2.2",
    "vitest": "^4.1.10"
  },
  "author": ""
}
