# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Environment (keep .env.example)
.env
.env.local

# Release build
release/

# Cache (portable Node.js downloads)
.cache/
.env.*.local

# MCP configuration files (may contain sensitive credentials)
*.mcp

# Runtime data
data/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Vite
src/webui/.vite/

# Temp / misc
*.tmp
temp/
workspace/

# scripts/runtime 下的 release 构建产物副本（源文件仅 *.bat / frontend-server.js 被跟踪）
scripts/runtime/package.json
scripts/runtime/tsconfig.json
scripts/runtime/使用说明.md
scripts/runtime/scripts/
scripts/runtime/dist/
scripts/runtime/webui/
scripts/runtime/node_modules/

# 数据备份（含敏感会话/记忆，绝不入库）
backups/
src_old/

# DSH 形态组合：profile 用户补丁层（本地差异，热生效）
/cordis.patch.yml

# 本地运行残留：仓库根被当作用户数据目录时产生的 Temp 部署产物
/AppData/

# Tauri 自动生成（desktop/src-tauri/gen/schemas，构建期再生）
desktop/src-tauri/gen/

# supervisor 单写者锁（supervisor.mjs 运行时产物）
src/.runtime

# src 本地数据根（含加密凭据/会话/记忆，绝不入库）
src/data/

# 运行时数据根落在仓库根时（boot 锚定启动 cwd）产生的运行时产物
/agents/
/files/
/memory/
/sessions/
/singles/
/usage/
/archive/
/groups/
/timer/
/.initialized
/config.json
/credentials.json
