  "devDependencies": {
    "ac-agent-loop": "workspace:*",
    "ac-llm": "workspace:*",
    "ac-extension-core": "workspace:*",
    "ac-tools": "workspace:*",
    "ac-fs-search": "workspace:*",
    "ac-str-replace-editor": "workspace:*",
    "vitest": "^4.1.10"
  },
  "agentchat": {
    "plugin": true
