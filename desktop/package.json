{
  "name": "ac-desktop",
  "version": "0.8.2",
  "private": true,
  "description": "AgentChat 桌面壳（Electron）——拉起 dist 发布形态后端并承载 WebUI",
  "main": "main.mjs",
  "type": "module",
  "license": "MIT",
  "author": "nefevcore",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nefevcore.agentchat",
    "productName": "AgentChat",
    "copyright": "MIT © nefevcore",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "agentchat",
        "filter": ["**/*"]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "nefevcore",
        "repo": "AgentChat",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}
