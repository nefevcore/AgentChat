{
  "name": "ac-desktop",
  "version": "0.8.14",
  "private": true,
  "description": "AgentChat 桌面壳（Electron）——拉起 dist 发布形态后端并承载 WebUI",
  "main": "main.mjs",
  "type": "module",
  "license": "MIT",
  "author": "nefevcore",
  "repository": {
    "type": "git",
    "url": "https://github.com/nefevcore/AgentChat.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nefevcore.agentchat",
    "productName": "AgentChat",
    "copyright": "MIT © nefevcore",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "build/icon.png",
      "build/icon@2x.png"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "agentchat",
        "filter": ["**/*"]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
      "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-"
    }
  }
}
