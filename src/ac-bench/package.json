    "ac-agent-loop": "workspace:*",
    "ac-llm": "workspace:*",
    "ac-openai-completions": "workspace:*",
    "ac-tools": "workspace:*"
  },
  "devDependencies": {
    "ac-extension-core": "workspace:*",
    "vitest": "^4.1.10"
  },
  "agentchat": {
    "plugin": true
  },
  "keywords": [
    "agentchat"
  ]
}
