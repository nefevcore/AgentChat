{
  "name": "ac-client-ui-sidebar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "sidebar 基础件前端行（M27.2-2 出包之四，phase:'base'）：活动栏域——sidebar 席位出厂贡献（SidebarHost：主题/设置/用量/版本入口 + 更多菜单 + sidebar:plugin-actions 贡献面）+ list-panel 席位出厂贡献（ListPanelsHost 三面板壳：AgentList/SessionList 内联 + 域贡献面板经 meta.panel 选举〔tracking = ui-runview 行贡献，M28 P1-3〕+ starColor 随件走，跨域数据经客户端服务面/包内门面消费）+ ui 面板状态 store（listPanel/可见性/resize——pinia，D10）+ 系统小 API（版本/备份）；无后端行",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./client": "./client/index.ts",
    "./client/*": "./client/*"
  },
  "scripts": {
    "test": "vitest run"
  },
  "agentchat": {
    "plugin": true,
    "client": {
      "platform": "web",
      "entry": "./client/index.ts",
      "phase": "base"
    }
  },
  "dependencies": {
    "@agentchat/cordis": "workspace:*",
    "@agentchat/webui-kit": "workspace:*",
    "ac-client-runtime": "workspace:*",
    "ac-client-slots": "workspace:*",
    "ac-client-ui-agents": "workspace:*",
    "ac-client-ui-conversation": "workspace:*",
    "ac-client-ui-jobs": "workspace:*",
    "ac-client-ui-theme": "workspace:*",
    "ac-client-ui-workspace": "workspace:*",
    "pinia": "^2.1.7",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "ac-extension-core": "workspace:*",
    "ac-webui": "workspace:*",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "agentchat"
  ]
}
