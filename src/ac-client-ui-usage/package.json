{
  "name": "ac-client-ui-usage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "usage 域前端行（M28 P1 §4.1 原案）：Token 用量面板——overlay 席位贡献（TokenUsageHost + 用量弹窗：柱状图/弦图/汇总）+ usageApi 数据面（usage/tokens RPC → UsageSummary 视图契约映射）随域迁入；与 ac-usage 后端行经 RPC 契约面耦合，双向可独立摘除",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./client": "./client/index.ts",
    "./client/*": "./client/*"
  },
  "scripts": {
    "test": "vitest run"
  },
  "agentchat": {
    "plugin": true,
    "client": {
      "platform": "web",
      "entry": "./client/index.ts",
      "phase": "domain"
    }
  },
  "dependencies": {
    "@agentchat/cordis": "workspace:*",
    "@agentchat/webui-kit": "workspace:*",
    "ac-client-runtime": "workspace:*",
    "ac-client-ui-layout": "workspace:*",
    "ac-client-ui-agents": "workspace:*",
    "ac-client-ui-theme": "workspace:*",
    "chart.js": "^4.5.1",
    "d3-chord": "^3.0.1",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/d3-chord": "^3.0.6",
    "ac-extension-core": "workspace:*",
    "ac-webui": "workspace:*",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "agentchat"
  ]
}
