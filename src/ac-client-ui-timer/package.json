{
  "name": "ac-client-ui-timer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "timer 域前端行：Agent 定时任务编辑视图（TimerPane——AgentPane 跨包消费）+ timers aux 聚合面板（TimersPanel/GlobalTimerHost——A3 起唯一全局任务入口）；数据面 timerApi（timer/entries RPC，M29 P1-3c 归域；TimerEntry 类型单源 ac-timer-core）",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./client": "./client/index.ts",
    "./client/*": "./client/*"
  },
  "scripts": {
    "test": "node ../../scripts/run-tests.mjs ."
  },
  "agentchat": {
    "plugin": true,
    "client": {
      "platform": "web",
      "entry": "./client/index.ts",
      "phase": "domain"
    }
  },
  "dependencies": {
    "@agentchat/cordis": "workspace:*",
    "@agentchat/webui-kit": "workspace:*",
    "ac-client-runtime": "workspace:*",
    "ac-client-ui-agents": "workspace:*",
    "ac-client-ui-layout": "workspace:*",
    "ac-client-ui-settings": "workspace:*",
    "ac-timer-core": "workspace:*",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "ac-extension-core": "workspace:*",
    "ac-webui": "workspace:*",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "agentchat"
  ]
}
