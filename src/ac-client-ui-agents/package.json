{
  "name": "ac-client-ui-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "agents 域前端行（M27.1 → M28 P1 行完整增重）：roster 身份面（ctx.roster：RosterCore 名册/预设/选择 + 显示名/头像解析）+ 名册/池/Token 直连数据面（rosterApi——fetchSessionTokens/deleteAgent/fetchPools；模型发现 2026-11 语义归位迁 ui-llm-pool/poolApi）；ui-group/ui-singles 等行间依赖方 inject 'roster' 走 fiber 等待；与 ac-agents 后端行经 RPC 契约面耦合，双向可独立摘除",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./client": "./client/index.ts",
    "./client/*": "./client/*"
  },
  "scripts": {
    "test": "vitest run"
  },
  "agentchat": {
    "plugin": true,
    "client": {
      "platform": "web",
      "entry": "./client/index.ts",
      "phase": "domain"
    }
  },
  "dependencies": {
    "@agentchat/cordis": "workspace:*",
    "@agentchat/webui-kit": "workspace:*",
    "ac-client-runtime": "workspace:*",
    "ac-client-ui-layout": "workspace:*",
    "ac-client-ui-conversation": "workspace:*",
    "ac-client-ui-llm-pool": "workspace:*",
    "ac-client-ui-plugin-registry": "workspace:*",
    "ac-client-ui-settings": "workspace:*",
    "ac-client-ui-theme": "workspace:*",
    "ac-client-ui-timer": "workspace:*",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "ac-agents": "workspace:*",
    "ac-extension-core": "workspace:*",
    "ac-webui": "workspace:*",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "agentchat"
  ]
}
