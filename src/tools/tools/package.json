{
  "name": "@agentchat/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "内置工具族：read/write/edit/bash + web_search + 会话/应用工具 + edit 引擎（hashline DSL）—— 迁移自 src/plugins/builtin/tools（files/web/session/app 族；agent/timer/subagent 工具随 svc 域迁移）",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentchat/agent-loop": "workspace:*",
    "@agentchat/agents": "workspace:*",
    "@agentchat/llm": "workspace:*",
    "@agentchat/router": "workspace:*",
    "@agentchat/cordis": "workspace:*",
    "@agentchat/edit": "workspace:*",
    "@agentchat/toolkit": "workspace:*",
    "@agentchat/timer": "workspace:*",
    "@agentchat/subagent": "workspace:*",
    "@agentchat/agent-config": "workspace:*",
    "@agentchat/fs": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
