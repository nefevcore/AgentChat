{
  "name": "ac-client-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "workspace 域前端行（M27.1 → M28 P1 行完整增重）：用户工作区域投影（ctx.workspaceBoard：清单 + CRUD）+ 域资产归位（fileApi 上传/目录浏览、EntryPickerModal 路径选择、FilePreviewModal 文件预览 = overlay 席位贡献、WorkspaceTree(/Node) 工作区树 = aside 席位选区条目（def id 'workspace'，自带 rail 收起态资产——2026-11 构造对齐·层级修正）、workspaceFile REST 读取）——数据面 = 宿主 REST/RPC，与 ac-workspace 后端行双向可独立摘除",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./client": "./client/index.ts",
    "./client/*": "./client/*"
  },
  "scripts": {
    "test": "vitest run"
  },
  "agentchat": {
    "plugin": true,
    "client": {
      "platform": "web",
      "entry": "./client/index.ts",
      "phase": "domain"
    }
  },
  "dependencies": {
    "@agentchat/cordis": "workspace:*",
    "@agentchat/webui-kit": "workspace:*",
    "ac-client-runtime": "workspace:*",
    "ac-client-ui-layout": "workspace:*",
    "ac-client-ui-renderer": "workspace:*",
    "highlight.js": "^11.11.1",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "ac-agent-store": "workspace:*",
    "ac-agents": "workspace:*",
    "ac-extension-core": "workspace:*",
    "ac-session": "workspace:*",
    "ac-webui": "workspace:*",
    "ac-workspace": "workspace:*",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "agentchat"
  ]
}
