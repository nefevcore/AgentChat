{
  "name": "@agentchat/fs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "文件工具（read/write/edit）—— 领域独立，可脱离 AgentChat 复用",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentchat/agent-loop": "workspace:*",
    "@agentchat/toolkit": "workspace:*",
    "@agentchat/tools": "workspace:*",
    "@agentchat/cordis": "workspace:*",
    "@agentchat/edit": "workspace:*",
    "@agentchat/agent-config": "workspace:*"
  }
}
