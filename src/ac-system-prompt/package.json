{
  "name": "ac-system-prompt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "系统提示词分块装配器（M14）：系统环境/术语约定[协作工具门控]/指引[request.tools 门控，条目级]/对话信息[信封 sender+conversationId] + override 覆盖；独立会话形态不注入多 Agent 协作知识；settings['system-prompt'] per-Agent 管控",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*"
  },
  "dependencies": {
    "@agentchat/cordis": "workspace:*",
    "ac-agents": "workspace:*"
  },
  "devDependencies": {
    "ac-agent-loop": "workspace:*",
    "ac-agents": "workspace:*",
    "ac-extension-core": "workspace:*",
    "ac-group": "workspace:*",
    "ac-llm": "workspace:*",
    "ac-tools": "workspace:*",
    "ac-workspace": "workspace:*",
    "vitest": "^4.1.10"
  },
  "agentchat": {
    "plugin": true
  },
  "keywords": [
    "agentchat"
  ]
} 
