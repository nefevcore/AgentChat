{
  "name": "ac-client-ui-conversation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "conversation 基础件前端行（M27.2-2 出包之五 → M28 P1 域资产归位收口，phase:'base'）：会话域——ctx.sessions 服务（FeedCore 统一信息流 + ChatCore 会话动作；rpc 经 RpcClientFace 契约面注入，名册经 roster 取用口注入）+ message:final-view/tracking:dock-widget 席位声明 + talk 视角出厂贡献 + 内置消息视图批次 + 会话类型/feed 工具链/历史回放 API + 视图半边（DialogView 族/ChatInput/InteractionBar/dock 纯壳 + 排队/滚动 composables + 上传登记消费门面）；无后端行（群写侧/技能/goal/名册池/文件面已随域行走）",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./client": "./client/index.ts",
    "./client/*": "./client/*"
  },
  "scripts": {
    "test": "vitest run"
  },
  "agentchat": {
    "plugin": true,
    "client": {
      "platform": "web",
      "entry": "./client/index.ts",
      "phase": "base"
    }
  },
  "dependencies": {
    "@agentchat/cordis": "workspace:*",
    "@agentchat/webui-kit": "workspace:*",
    "ac-client-runtime": "workspace:*",
    "ac-client-slots": "workspace:*",
    "ac-client-ui-agents": "workspace:*",
    "ac-client-ui-group": "workspace:*",
    "ac-client-ui-jobs": "workspace:*",
    "ac-client-ui-renderer": "workspace:*",
    "ac-client-ui-sidebar": "workspace:*",
    "ac-client-ui-singles": "workspace:*",
    "ac-client-ui-skill": "workspace:*",
    "ac-client-ui-tool": "workspace:*",
    "ac-client-ui-workspace": "workspace:*",
    "highlight.js": "^11.11.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "ac-extension-core": "workspace:*",
    "ac-webui": "workspace:*",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "agentchat"
  ]
}
