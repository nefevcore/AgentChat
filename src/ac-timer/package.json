{
  "name": "ac-timer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "定时任务服务（ctx.timers）：5 模式调度（叠官方 cordis-timer 的 ctx.timeout 排程）+ 限定次数/永久 + 停机补偿（原子写状态 + 30s 心跳）+ 条目持久化归 ac-agent-store + 全局条目 config timer.tasks + 触发=conversation.deliver sender:'event' + 机制任务直调（archive-all/backup-all）",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "node ../../scripts/run-tests.mjs ."
  },
  "dependencies": {
    "@agentchat/cordis": "workspace:*",
    "ac-timer-core": "workspace:*"
  },
  "devDependencies": {
    "@agentchat/cordis-timer": "workspace:*",
    "ac-agent-loop": "workspace:*",
    "ac-agent-store": "workspace:*",
    "ac-agents": "workspace:*",
    "ac-config": "workspace:*",
    "ac-conversation": "workspace:*",
    "ac-extension-core": "workspace:*",
    "ac-llm": "workspace:*",
    "ac-router": "workspace:*",
    "ac-tools": "workspace:*",
    "vitest": "^4.1.10"
  },
  "agentchat": {
    "plugin": true
  },
  "keywords": [
    "agentchat"
  ]
}
