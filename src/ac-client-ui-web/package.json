{
  "name": "ac-client-ui-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "web 域工具卡前端行（M28 P2 §2.2 镜像表）：web_search + 浏览器族正则（fetch_webpage 等 11 工具）→ ToolResultWeb（ac-web-tools 镜像）；aux 'search' 选区——多 tab 搜索结果面板（卡片点击侧边栏展开，write 直达 preview 同款交互）；卸本行 → 卡片回落文本渲染，与后端行双向可独立摘除",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*",
    "./client": "./client/index.ts",
    "./client/*": "./client/*"
  },
  "scripts": {
    "test": "node ../../scripts/run-tests.mjs ."
  },
  "agentchat": {
    "plugin": true,
    "client": {
      "platform": "web",
      "entry": "./client/index.ts",
      "phase": "domain"
    }
  },
  "dependencies": {
    "@agentchat/cordis": "workspace:*",
    "@agentchat/webui-kit": "workspace:*",
    "ac-client-runtime": "workspace:*",
    "ac-client-ui-layout": "workspace:*",
    "pinia": "^2.1.7",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "ac-extension-core": "workspace:*",
    "ac-webui": "workspace:*",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "agentchat"
  ]
}
