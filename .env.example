# ============================================
# AgentChat 环境变量配置
# ============================================
# 复制此文件为 .env 或 workspace/default/.env
# 然后填入你的 API 密钥

# DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-key-here

# OpenAI API Key
OPENAI_API_KEY=sk-your-key-here

# 自定义工作空间路径（可选，默认为 workspace/default）
# AGENTCHAT_WORKSPACE=workspace/default
